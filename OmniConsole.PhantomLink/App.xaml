<Application
    x:Class="OmniConsole.PhantomLink.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniConsole.PhantomLink">

    <!-- 套用 WinUI 2.x（Microsoft.UI.Xaml 2.8）Fluent 樣式：
         UWP 標準控制項（ComboBox / ComboBoxItem / ToggleSwitch / Button 等）
         自動換成與 WinUI 3 觀感一致的 default style；不需逐一指定 muxc: 前綴。 -->
    <Application.Resources>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
    </Application.Resources>

</Application>
