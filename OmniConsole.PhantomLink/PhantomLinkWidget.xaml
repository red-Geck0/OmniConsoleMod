<Page
    x:Class="OmniConsole.PhantomLink.PhantomLinkWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniConsole.PhantomLink"
    xmlns:services="using:OmniConsole.PhantomLink.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontSize="18"
    UseSystemFocusVisuals="False">

    <Page.Resources>
        <!-- WinUI 2.x（Microsoft.UI.Xaml 2.8）已透過 App.xaml 的 XamlControlsResources 套用 Fluent 預設樣式；
             這裡只 override 兩個視覺微調項，其餘交給 Fluent default。 -->
        <Style TargetType="ToggleButton">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
    </Page.Resources>

    <!-- Padding 左右對稱（20/20）；StackPanel 再額外加 4px 左右 margin 留給 ComboBox 等 focus visual 繪製。
         ScrollViewer 會在自己邊界 clip 子內容，控制項若 flush 邊界其 focus visual（畫在控制項外 ~3-4px）會被切掉，
         故 StackPanel 留 4px 內縮，讓 focus visual 落在 ScrollViewer clip 內。 -->
    <Grid Padding="20,0,20,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RootPanel" Spacing="12" Margin="4,0,4,0">

                <!-- Quick Actions: TaskView / XboxLibrary 兩顆水平排列；委派給 PhantomBridge COM server.
                     不設 XYFocusUp —— 讓 D-pad Up 從最頂端按鈕外移到 Game Bar，使用者能回到小工具切換列。 -->
                <Grid x:Name="QuickActionsSection" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TaskViewBtn" Grid.Column="0"
                            Click="TaskViewBtn_Click"
                            HorizontalAlignment="Stretch"
                            UseSystemFocusVisuals="True"
                            XYFocusDown="{x:Bind SteamInGameOverlayOffBtn}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7C4;" FontSize="16"/>
                            <TextBlock x:Uid="Widget_OpenTaskView"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="XboxLibraryBtn" Grid.Column="1"
                            Click="XboxLibraryBtn_Click"
                            HorizontalAlignment="Stretch"
                            UseSystemFocusVisuals="True"
                            XYFocusDown="{x:Bind SteamInGameOverlayOnBtn}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE990;" FontSize="16"/>
                            <TextBlock x:Uid="Widget_OpenXboxLibrary"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Steam In-Game Overlay: [Off] [Trigger] [On] 三顆水平排列（獨立於 Mouse Mode）。 -->
                <StackPanel x:Name="SteamInGameOverlaySection" Spacing="6">
                    <TextBlock x:Uid="Widget_SteamInGameOverlay_Title" services:FluentIconTextHelper.AutoFormat="True" FontWeight="SemiBold"/>
                    <StackPanel x:Name="SteamInGameOverlayButtonRow" Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="SteamInGameOverlayOffBtn" x:Uid="Widget_SteamInGameOverlay_Off"
                                      Click="SteamInGameOverlayBtn_Click" Tag="Off"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind TaskViewBtn}"
                                      XYFocusLeft="{x:Bind SteamInGameOverlayOffBtn}"
                                      XYFocusRight="{x:Bind TriggerSteamInGameOverlayBtn}"
                                      XYFocusDown="{x:Bind ModeSwitch}"/>
                        <Button x:Name="TriggerSteamInGameOverlayBtn"
                                Click="TriggerSteamInGameOverlayBtn_Click"
                                UseSystemFocusVisuals="True"
                                Visibility="Collapsed"
                                XYFocusUp="{x:Bind XboxLibraryBtn}"
                                XYFocusLeft="{x:Bind SteamInGameOverlayOffBtn}"
                                XYFocusRight="{x:Bind SteamInGameOverlayOnBtn}"
                                XYFocusDown="{x:Bind ModeSwitch}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA5B;" FontSize="16"/>
                                <TextBlock x:Uid="Widget_TriggerSteamInGameOverlay"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="SteamInGameOverlayOnBtn" x:Uid="Widget_SteamInGameOverlay_On"
                                      Click="SteamInGameOverlayBtn_Click" Tag="On"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind XboxLibraryBtn}"
                                      XYFocusLeft="{x:Bind TriggerSteamInGameOverlayBtn}"
                                      XYFocusRight="{x:Bind SteamInGameOverlayOnBtn}"
                                      XYFocusDown="{x:Bind ModeSwitch}"/>
                    </StackPanel>
                    <!-- 平台適用性說明：此功能仰賴 Steam 長按 ☰ 觸發 Shift+Tab，需預設平台為 Steam Big Picture -->
                    <TextBlock x:Uid="Widget_SteamInGameOverlay_PlatformNote"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Mouse Mode: On/Off 開關 -->
                <StackPanel x:Name="ModeSection" Spacing="6">
                    <TextBlock x:Uid="Widget_MouseMode_Title" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="ModeSwitch"
                                  Toggled="ModeSwitch_Toggled"
                                  XYFocusUp="{x:Bind SteamInGameOverlayOffBtn}"/>
                </StackPanel>

                <!-- 前景程式區塊：兩行（Label + 粗體名稱）。
                     位於 Mouse Mode 下方，profile 指派區上方。 -->
                <StackPanel x:Name="ForegroundAppSection" Spacing="2">
                    <TextBlock x:Name="ForegroundAppLabelText" FontSize="13"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    <TextBlock x:Name="ForegroundAppNameText" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- CustomizeAppNoteText：前景為系統管理員程式時顯示說明 -->
                    <TextBlock x:Name="CustomizeAppNoteText"
                               x:Uid="Widget_CustomizeApp_ElevatedNote"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 指派區：下拉選 profile（選即套用），下方為編輯 profile 按鈕（開主程式設定頁）。
                     Mouse Mode = Off 時整段隱藏。
                     ProfileCombo MinHeight=56 / FontSize=16 模擬 Windows 11 設定頁原生 ComboBox 外觀；
                     ItemContainerStyle 拉高下拉選單每一列高度，與設定頁觀感一致。 -->
                <StackPanel x:Name="ProfileSection" Spacing="6">
                    <!-- WinUI 2.x Fluent default 已提供 Windows 11 設定頁觀感（含 dropdown item 高度、padding、selected indicator）。
                         僅以 MinHeight 拉高方便手把/觸控操作；其餘樣式交給 Fluent default。 -->
                    <ComboBox x:Name="ProfileCombo"
                              HorizontalAlignment="Stretch"
                              MinHeight="40"
                              SelectionChanged="ProfileCombo_SelectionChanged"
                              UseSystemFocusVisuals="True"
                              XYFocusUp="{x:Bind ModeSwitch}"
                              XYFocusDown="{x:Bind EditProfileBtn}"/>
                    <Button x:Name="EditProfileBtn"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            MinHeight="44"
                            Click="EditProfileBtn_Click"
                            UseSystemFocusVisuals="True"
                            XYFocusUp="{x:Bind ProfileCombo}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" FontSize="16"/>
                            <TextBlock x:Uid="Widget_EditProfile"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 內建手把映射說明（ROG Ally 家族時顯示） -->
                <TextBlock x:Name="BuiltInMappingNote" x:Uid="Widget_BuiltInMappingNote"
                           Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                           FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
