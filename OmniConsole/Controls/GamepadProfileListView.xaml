<UserControl
    x:Class="OmniConsole.Controls.GamepadProfileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniConsole.Controls">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#25282C"/>
        <!-- 關掉 ListViewItem 左側 selection accent bar，焦點視覺僅保留白框。 -->
        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
    </UserControl.Resources>

    <ScrollViewer Padding="0" VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- 與 Advanced / About 一致：頂端對齊、置中、最大寬 700，分段卡片排版。 -->
        <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="700" Margin="0,24,0,24">
            <TextBlock x:Uid="GamepadMappingTitle" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock x:Uid="GamepadMappingPageDesc" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- ── Section 1：OmniNav Mode ── -->
            <TextBlock x:Uid="OmniNavModeSection" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    HorizontalAlignment="Stretch" MinWidth="700">
                <Grid Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE962;" FontSize="24" Margin="0,0,16,0"
                              VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- 標題：取代「Gamepad Mouse Mode」 -->
                        <TextBlock x:Uid="OmniNavModeTitle" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                        <!-- 副標：使用預設 profile 之說明 -->
                        <TextBlock x:Uid="GamepadMappingDescription"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <!-- 黃色提示：系統應用已排除（遊戲偵測限制提示已移至「設為預設」對話方塊） -->
                        <TextBlock x:Uid="GamepadMappingNavConflictNote"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <!-- 黃色提示：內建廠商映射時停用（預設隱藏） -->
                        <TextBlock x:Name="MouseModeBuiltInNote"
                                   x:Uid="MouseModeSetting_BuiltInMappingNote"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                        <!-- 黃色提示：偵測到別的軟體也在把搖桿轉成游標（Game Bar 的 Gamepad Cursor 等；預設隱藏） -->
                        <TextBlock x:Name="ExternalCursorConflictNote"
                                   x:Uid="MouseModeSetting_ExternalCursorNote"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                        <!-- 黃色提示：前景是系統管理員程式，映射被 UIPI 擋掉（預設隱藏） -->
                        <TextBlock x:Name="ElevatedInputBlockedNote"
                                   x:Uid="MouseModeSetting_ElevatedBlockedNote"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="MouseModeSwitch"
                                  Toggled="MouseModeSwitch_Toggled"
                                  FlowDirection="RightToLeft"
                                  Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0"
                                  UseSystemFocusVisuals="True"/>
                </Grid>
            </Border>

            <!-- ── Section 2：Profiles ── -->
            <TextBlock x:Uid="GamepadProfilesLabel" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border x:Name="ListCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <ListView x:Name="ProfileList"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="ProfileList_ItemClick"
                          Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:GamepadProfileRow">
                            <Grid Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            Spacing="6" VerticalAlignment="Center" Margin="8,0">
                                    <!-- App 預設徽章（深藍 / navy） -->
                                    <Border Visibility="{x:Bind BadgeVisibility}"
                                            Background="#1B3A6B"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Badge}" FontSize="12"/>
                                    </Border>
                                    <!-- 遊戲預設徽章（不同色以區分） -->
                                    <Border Visibility="{x:Bind GameBadgeVisibility}"
                                            Background="#2E7D32"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind GameBadge}" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- New profile：列表下方；手把 Y 鍵改為 Set as default（在 ProfileList 上時觸發）。 -->
            <Button x:Name="NewProfileButton"
                    Click="NewProfileButton_Click"
                    HorizontalAlignment="Center"
                    UseSystemFocusVisuals="True">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                    <TextBlock x:Uid="GamepadProfileNewButton"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
