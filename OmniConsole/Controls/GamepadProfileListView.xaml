<UserControl
    x:Class="OmniConsole.Controls.GamepadProfileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniConsole.Controls">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#25282C"/>
        <!-- 關掉 ListViewItem 左側 selection accent bar，焦點視覺僅保留白框。 -->
        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
    </UserControl.Resources>

    <ScrollViewer Padding="0" VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Uid="GamepadMappingTitle" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>

            <!-- Gamepad Mouse Mode 主開關（自 Advanced 設定移來，置於標題正下方）。 -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Uid="MouseModeSetting_Title" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ToggleSwitch x:Name="MouseModeSwitch"
                              Toggled="MouseModeSwitch_Toggled"
                              MinWidth="0" VerticalAlignment="Center"
                              UseSystemFocusVisuals="True"/>
            </StackPanel>
            <!-- 內建廠商手把映射（ROG Ally 等）時 mouse mode 停用提示 -->
            <TextBlock x:Name="MouseModeBuiltInNote"
                       x:Uid="MouseModeSetting_BuiltInMappingNote"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       Visibility="Collapsed" Margin="0,0,0,4"/>

            <TextBlock x:Uid="GamepadMappingDescription" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>

            <!-- 提示：系統應用已從指派中排除 -->
            <TextBlock x:Uid="GamepadMappingNavConflictNote"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       MaxWidth="700"
                       Margin="0,0,0,4"/>

            <!-- 提示：遊戲偵測的限制 -->
            <TextBlock x:Uid="GamepadMappingGameDetectNote"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       MaxWidth="700"
                       Margin="0,0,0,8"/>

            <!-- Profiles 區段標題 -->
            <TextBlock x:Uid="GamepadProfilesLabel"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>

            <Border x:Name="ListCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    HorizontalAlignment="Center"
                    MinWidth="700"
                    MaxWidth="700">
                <ListView x:Name="ProfileList"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="ProfileList_ItemClick"
                          Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:GamepadProfileRow">
                            <Grid Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            Spacing="6" VerticalAlignment="Center" Margin="8,0">
                                    <!-- App 預設徽章 -->
                                    <Border Visibility="{x:Bind BadgeVisibility}"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Badge}" FontSize="12"/>
                                    </Border>
                                    <!-- 遊戲預設徽章（不同色以區分） -->
                                    <Border Visibility="{x:Bind GameBadgeVisibility}"
                                            Background="#2E7D32"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind GameBadge}" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- New profile：移到 list 下方；手把 Y 鍵改為 Set as default（在 ProfileList 上時觸發），
                 New profile 僅可由滑鼠/觸控/A 鍵點擊此按鈕觸發 -->
            <Button x:Name="NewProfileButton"
                    Click="NewProfileButton_Click"
                    HorizontalAlignment="Center"
                    UseSystemFocusVisuals="True">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                    <TextBlock x:Uid="GamepadProfileNewButton"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
