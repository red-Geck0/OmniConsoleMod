<ContentDialog
    x:Class="OmniConsole.Dialogs.CustomPlatformConsentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Close"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="#25282C"/>
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#1A1B1E"/>
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="Transparent"/>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#25282C"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" MaxWidth="440">
        <FontIcon Glyph="&#xE7BA;" FontSize="40"
                  HorizontalAlignment="Center"
                  Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
        <TextBlock x:Uid="CustomPlatform_ConsentBody"
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</ContentDialog>
