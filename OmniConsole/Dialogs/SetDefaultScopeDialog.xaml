<ContentDialog
    x:Class="OmniConsole.Dialogs.SetDefaultScopeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="#25282C"/>
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#1A1B1E"/>
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="Transparent"/>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#25282C"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="10" MinWidth="320">
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="14"/>
        <!-- 遊戲偵測限制提示（黃色），置於本體文字下方 -->
        <TextBlock x:Uid="GamepadMappingGameDetectNote"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                   FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
